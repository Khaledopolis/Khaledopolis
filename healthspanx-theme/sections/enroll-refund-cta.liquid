<section
  class="enroll-refund-cta"
  style="background-color: {{ section.settings.bg_color }};"
  data-section-id="{{ section.id }}"
  data-section-type="enroll-refund-cta"
>
  <div class="enroll-refund-cta__inner">

    {% if section.settings.refund_text != blank %}
      <p
        class="enroll-refund-cta__refund"
        style="color: {{ section.settings.refund_color }};"
      >
        {{ section.settings.refund_text }}
      </p>
    {% endif %}

    <div class="enroll-refund-cta__cta-wrap">
      <a
        href="{{ section.settings.cta_url }}"
        class="enroll-refund-cta__button"
        style="background-color: {{ section.settings.cta_bg_color }}; color: {{ section.settings.cta_text_color }};"
      >
        {{ section.settings.cta_text }}
      </a>

      {% if section.settings.micro_text != blank %}
        <p class="enroll-refund-cta__micro">
          {{ section.settings.micro_text }}
        </p>
      {% endif %}
    </div>

  </div>
</section>

<style>
  .enroll-refund-cta {
    padding: 72px 24px 96px;
  }

  .enroll-refund-cta__inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    text-align: center;
  }

  .enroll-refund-cta__refund {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.7;
    margin: 0;
    padding: 20px 24px;
    border: 1px solid #D6DEDF;
    border-radius: 4px;
    background-color: #EEF3F2;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
  }

  .enroll-refund-cta__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .enroll-refund-cta__button {
    display: inline-block;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 16px 40px;
    border-radius: 2px;
    line-height: 1;
    transition: opacity 0.2s ease;
    text-transform: none;
    min-width: 240px;
    text-align: center;
  }

  .enroll-refund-cta__button:hover {
    opacity: 0.88;
  }

  .enroll-refund-cta__button:focus-visible {
    outline: 2px solid #3D7A72;
    outline-offset: 3px;
  }

  .enroll-refund-cta__micro {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.6;
    color: #8A9DA0;
    margin: 0;
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .enroll-refund-cta {
      padding: 56px 20px 72px;
    }

    .enroll-refund-cta__button {
      width: 100%;
      padding: 16px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Enroll Refund & CTA",
  "tag": "section",
  "class": "section-enroll-refund-cta",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F6F3"
    },
    {
      "type": "header",
      "content": "Refund Text"
    },
    {
      "type": "textarea",
      "id": "refund_text",
      "label": "Refund Text",
      "default": "Refund eligibility evaluated after full completion. Unremarkable outcome is valid data. Purpose is fairness, not incentive."
    },
    {
      "type": "color",
      "id": "refund_color",
      "label": "Refund Text Color",
      "default": "#5C6B6E"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Enroll in RL100"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Button Background Color",
      "default": "#3D7A72"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Micro Text"
    },
    {
      "type": "text",
      "id": "micro_text",
      "label": "Micro Text (below button)",
      "default": "Enrollment confirms your agreement to follow standardized conditions for 100 days."
    }
  ],
  "presets": [
    {
      "name": "Enroll Refund & CTA"
    }
  ]
}
{% endschema %}
