<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

{% if section.settings.show_section %}
<style>
  #home-deliberate-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    font-family: 'Inter', sans-serif;
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 40px;
    background: none;
    border: none;
    border-bottom: 1px solid #D6DEDF;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #1A2224;
    letter-spacing: 0.01em;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger:hover {
    background-color: rgba(61, 122, 114, 0.04);
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger .trigger-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
    margin-left: 16px;
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger .trigger-icon::before,
  #home-deliberate-{{ section.id }} .deliberate-trigger .trigger-icon::after {
    content: '';
    position: absolute;
    background-color: #3D7A72;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger .trigger-icon::before {
    width: 14px;
    height: 2px;
    top: 9px;
    left: 3px;
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger .trigger-icon::after {
    width: 2px;
    height: 14px;
    top: 3px;
    left: 9px;
  }

  #home-deliberate-{{ section.id }} .deliberate-trigger[aria-expanded="true"] .trigger-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  #home-deliberate-{{ section.id }} .deliberate-panel {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s ease;
  }

  #home-deliberate-{{ section.id }} .deliberate-panel.is-open {
    max-height: 600px;
  }

  #home-deliberate-{{ section.id }} .deliberate-panel-inner {
    padding: 64px 40px;
    max-width: 760px;
    margin: 0 auto;
  }

  #home-deliberate-{{ section.id }} .deliberate-heading {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 700;
    color: #1A2224;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 24px 0;
  }

  #home-deliberate-{{ section.id }} .deliberate-body {
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: #5C6B6E;
    line-height: 1.75;
    margin: 0;
  }

  @media (max-width: 768px) {
    #home-deliberate-{{ section.id }} .deliberate-trigger {
      padding: 24px;
    }

    #home-deliberate-{{ section.id }} .deliberate-panel-inner {
      padding: 48px 24px;
    }
  }

  @media (max-width: 480px) {
    #home-deliberate-{{ section.id }} .deliberate-trigger {
      padding: 20px;
      font-size: 14px;
    }

    #home-deliberate-{{ section.id }} .deliberate-panel-inner {
      padding: 40px 20px;
    }
  }
</style>

<section id="home-deliberate-{{ section.id }}">
  <button
    class="deliberate-trigger"
    aria-expanded="false"
    aria-controls="deliberate-panel-{{ section.id }}"
    id="deliberate-btn-{{ section.id }}"
  >
    <span>{{ section.settings.toggle_label }}</span>
    <span class="trigger-icon" aria-hidden="true"></span>
  </button>

  <div
    class="deliberate-panel"
    id="deliberate-panel-{{ section.id }}"
    role="region"
    aria-labelledby="deliberate-btn-{{ section.id }}"
  >
    <div class="deliberate-panel-inner">
      <h2 class="deliberate-heading">{{ section.settings.heading_text }}</h2>
      <p class="deliberate-body">{{ section.settings.body_text }}</p>
    </div>
  </div>
</section>

<script>
  (function() {
    var btn = document.getElementById('deliberate-btn-{{ section.id }}');
    var panel = document.getElementById('deliberate-panel-{{ section.id }}');
    if (btn && panel) {
      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        if (!expanded) {
          panel.classList.add('is-open');
        } else {
          panel.classList.remove('is-open');
        }
      });
    }
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Home — Designed to Be Deliberate",
  "tag": "section",
  "class": "home-deliberate-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show Section",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F6F3"
    },
    {
      "type": "header",
      "content": "Accordion"
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Accordion Toggle Label",
      "default": "Why We're Designed to Be Deliberate"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "Designed to Be Deliberate"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Radiant Life™ intentionally resists impulse decisions, outcome promises, and optimization chasing. Biology does not operate on consumer timelines."
    }
  ],
  "presets": [
    {
      "name": "Home — Designed to Be Deliberate"
    }
  ]
}
{% endschema %}
