<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  #home-bio-toolset-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: 96px 40px;
    font-family: 'Inter', sans-serif;
  }

  #home-bio-toolset-{{ section.id }} .toolset-inner {
    max-width: 1140px;
    margin: 0 auto;
  }

  #home-bio-toolset-{{ section.id }} .toolset-header {
    margin-bottom: 48px;
  }

  #home-bio-toolset-{{ section.id }} .toolset-heading {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 12px 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-subtext {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #5C6B6E;
    line-height: 1.6;
    margin: 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile {
    background-color: {{ section.settings.tile_bg }};
    border: 1px solid {{ section.settings.tile_border_color }};
    border-radius: 6px;
    padding: 28px 24px;
    cursor: pointer;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile:hover {
    box-shadow: 0 4px 20px rgba(30, 43, 47, 0.08);
    transform: translateY(-2px);
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile__badge {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid {{ section.settings.badge_color }};
    border-radius: 20px;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    color: {{ section.settings.badge_color }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile__category {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: #8A9DA0;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 8px 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile__name {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 17px;
    font-weight: 700;
    color: #1A2224;
    line-height: 1.3;
    margin: 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile__learn {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: {{ section.settings.badge_color }};
    letter-spacing: 0.04em;
  }

  #home-bio-toolset-{{ section.id }} .toolset-tile__learn::after {
    content: '→';
    font-size: 14px;
  }

  #home-bio-toolset-{{ section.id }} .toolset-note {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #8A9DA0;
    letter-spacing: 0.02em;
    text-align: center;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid #D6DEDF;
  }

  /* Modal styles */
  #home-bio-toolset-{{ section.id }} .toolset-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(26, 34, 36, 0.6);
    z-index: 9000;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal-overlay.is-open {
    display: flex;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal {
    background: #FFFFFF;
    border-radius: 8px;
    padding: 48px;
    max-width: 560px;
    width: 100%;
    position: relative;
    box-shadow: 0 20px 60px rgba(26, 34, 36, 0.2);
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8A9DA0;
    font-size: 22px;
    line-height: 1;
    padding: 0;
    border-radius: 4px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__close:hover {
    color: #1A2224;
    background-color: #EEF3F2;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__badge {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid {{ section.settings.badge_color }};
    border-radius: 20px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: {{ section.settings.badge_color }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__category {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #8A9DA0;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 8px 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__name {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 26px;
    font-weight: 700;
    color: #1A2224;
    line-height: 1.2;
    margin: 0 0 20px 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__description {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #5C6B6E;
    line-height: 1.75;
    margin: 0 0 24px 0;
  }

  #home-bio-toolset-{{ section.id }} .toolset-modal__notice {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #8A9DA0;
    line-height: 1.6;
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid #D6DEDF;
  }

  @media (max-width: 1024px) {
    #home-bio-toolset-{{ section.id }} .toolset-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    #home-bio-toolset-{{ section.id }} {
      padding: 72px 24px;
    }

    #home-bio-toolset-{{ section.id }} .toolset-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    #home-bio-toolset-{{ section.id }} .toolset-modal {
      padding: 32px 24px;
    }
  }

  @media (max-width: 480px) {
    #home-bio-toolset-{{ section.id }} {
      padding: 56px 20px;
    }

    #home-bio-toolset-{{ section.id }} .toolset-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section id="home-bio-toolset-{{ section.id }}">
  <div class="toolset-inner">
    <div class="toolset-header">
      <h2 class="toolset-heading">{{ section.settings.heading_text }}</h2>
      <p class="toolset-subtext">{{ section.settings.subtext }}</p>
    </div>

    <div class="toolset-grid">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
          <div
            class="toolset-tile"
            data-modal-target="toolset-modal-{{ section.id }}"
            data-product-name="{{ block.settings.product_name | escape }}"
            data-product-category="{{ block.settings.product_category | escape }}"
            data-product-description="{{ block.settings.product_description | escape }}"
            data-product-badge="{{ block.settings.badge_label | escape }}"
            role="button"
            tabindex="0"
            aria-label="Learn about {{ block.settings.product_name }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.badge_label != blank %}
              <span class="toolset-tile__badge">{{ block.settings.badge_label }}</span>
            {% endif %}
            {% if block.settings.product_category != blank %}
              <p class="toolset-tile__category">{{ block.settings.product_category }}</p>
            {% endif %}
            <h3 class="toolset-tile__name">{{ block.settings.product_name }}</h3>
            <div class="toolset-tile__learn">Educational Overview</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <p class="toolset-note">{{ section.settings.note_text }}</p>
  </div>
</section>

<!-- Educational Modal -->
<div
  class="toolset-modal-overlay"
  id="toolset-modal-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="toolset-modal-name-{{ section.id }}"
>
  <div class="toolset-modal">
    <button class="toolset-modal__close" aria-label="Close">&times;</button>
    <div class="toolset-modal__badge" id="toolset-modal-badge-{{ section.id }}"></div>
    <p class="toolset-modal__category" id="toolset-modal-category-{{ section.id }}"></p>
    <h2 class="toolset-modal__name" id="toolset-modal-name-{{ section.id }}"></h2>
    <p class="toolset-modal__description" id="toolset-modal-desc-{{ section.id }}"></p>
    <p class="toolset-modal__notice">Product access determined through assessment only. No prices shown.</p>
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('home-bio-toolset-{{ section.id }}');
    var overlay = document.getElementById('toolset-modal-{{ section.id }}');
    if (!section || !overlay) return;

    var modalBadge = document.getElementById('toolset-modal-badge-{{ section.id }}');
    var modalCategory = document.getElementById('toolset-modal-category-{{ section.id }}');
    var modalName = document.getElementById('toolset-modal-name-{{ section.id }}');
    var modalDesc = document.getElementById('toolset-modal-desc-{{ section.id }}');
    var closeBtn = overlay.querySelector('.toolset-modal__close');

    function openModal(tile) {
      modalBadge.textContent = tile.dataset.productBadge || '';
      modalBadge.style.display = tile.dataset.productBadge ? 'inline-block' : 'none';
      modalCategory.textContent = tile.dataset.productCategory || '';
      modalName.textContent = tile.dataset.productName || '';
      modalDesc.textContent = tile.dataset.productDescription || '';
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeModal() {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    var tiles = section.querySelectorAll('.toolset-tile');
    tiles.forEach(function(tile) {
      tile.addEventListener('click', function() { openModal(tile); });
      tile.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(tile);
        }
      });
    });

    closeBtn.addEventListener('click', closeModal);

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeModal();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
        closeModal();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Home — Biological Toolset",
  "tag": "section",
  "class": "home-biological-toolset-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F6F3"
    },
    {
      "type": "color",
      "id": "tile_bg",
      "label": "Tile Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tile_border_color",
      "label": "Tile Border Color",
      "default": "#D6DEDF"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Outline & Text Color (Mineral Teal)",
      "default": "#3D7A72"
    },
    {
      "type": "header",
      "content": "Heading & Text"
    },
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Section Heading",
      "default": "The Radiant Life™ Biological Toolset"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1A2224"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext below heading",
      "default": "Eligibility is determined through assessment and tracking."
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note text below grid",
      "default": "Product access determined through assessment only. No prices shown."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Tile",
      "settings": [
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "product_category",
          "label": "Product Category",
          "default": "Category"
        },
        {
          "type": "textarea",
          "id": "product_description",
          "label": "Educational Description (shown in modal)",
          "default": "Educational description of this biological tool and its role within the Radiant Life™ system."
        },
        {
          "type": "text",
          "id": "badge_label",
          "label": "Badge Label",
          "default": "RL100"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home — Biological Toolset",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "product_name": "Product One",
            "product_category": "Topical",
            "product_description": "A standardized topical formulation used within the RL100 measurement window. Applied under controlled conditions to assess observable biological response.",
            "badge_label": "RL100"
          }
        },
        {
          "type": "product",
          "settings": {
            "product_name": "Product Two",
            "product_category": "Oral",
            "product_description": "An oral biological tool applied within the RL100 protocol. Eligibility and dosage determined through assessment data.",
            "badge_label": "RL100"
          }
        },
        {
          "type": "product",
          "settings": {
            "product_name": "Product Three",
            "product_category": "Supplement",
            "product_description": "A standardized supplement designed to support baseline biological conditions during the 100-day measurement window.",
            "badge_label": "RL100"
          }
        }
      ]
    }
  ]
}
{% endschema %}
