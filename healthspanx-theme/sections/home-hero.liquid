<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  #home-hero-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    min-height: {{ section.settings.section_height }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  {% if section.settings.show_texture %}
  #home-hero-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 50%, rgba(61, 122, 114, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 80% 30%, rgba(196, 137, 106, 0.06) 0%, transparent 55%),
      radial-gradient(ellipse 40% 40% at 50% 80%, rgba(61, 122, 114, 0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  #home-hero-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 60px,
        rgba(255,255,255,0.015) 60px,
        rgba(255,255,255,0.015) 61px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 80px,
        rgba(255,255,255,0.012) 80px,
        rgba(255,255,255,0.012) 81px
      );
    pointer-events: none;
    z-index: 0;
  }
  {% endif %}

  #home-hero-{{ section.id }} .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    padding: 80px 40px;
    text-align: center;
  }

  #home-hero-{{ section.id }} h1 {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: {{ section.settings.heading_size }};
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 28px 0;
  }

  #home-hero-{{ section.id }} .hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: {{ section.settings.body_color }};
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto 40px auto;
    opacity: 0.88;
  }

  #home-hero-{{ section.id }} .hero-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  #home-hero-{{ section.id }} .hero-cta {
    display: inline-block;
    background-color: {{ section.settings.cta_bg_color }};
    color: {{ section.settings.cta_text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 40px;
    border-radius: 3px;
    transition: opacity 0.2s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
  }

  #home-hero-{{ section.id }} .hero-cta:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  #home-hero-{{ section.id }} .hero-micro {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: {{ section.settings.body_color }};
    opacity: 0.5;
    letter-spacing: 0.02em;
    margin: 0;
  }

  @media (max-width: 768px) {
    #home-hero-{{ section.id }} .hero-inner {
      padding: 60px 24px;
    }

    #home-hero-{{ section.id }} h1 {
      font-size: clamp(28px, 7vw, 48px);
    }

    #home-hero-{{ section.id }} .hero-sub {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    #home-hero-{{ section.id }} .hero-inner {
      padding: 48px 20px;
    }

    #home-hero-{{ section.id }} .hero-cta {
      width: 100%;
      text-align: center;
    }
  }
</style>

<section id="home-hero-{{ section.id }}" role="banner">
  <div class="hero-inner">
    <h1>{{ section.settings.heading_text }}</h1>
    <p class="hero-sub">{{ section.settings.body_text }}</p>
    <div class="hero-cta-wrap">
      <a href="{{ section.settings.cta_url }}" class="hero-cta">
        {{ section.settings.cta_text }}
      </a>
      <p class="hero-micro">{{ section.settings.micro_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home — Hero",
  "tag": "section",
  "class": "home-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1E2B2F"
    },
    {
      "type": "checkbox",
      "id": "show_texture",
      "label": "Show Abstract Texture Overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        { "value": "60vh", "label": "60vh" },
        { "value": "65vh", "label": "65vh" },
        { "value": "70vh", "label": "70vh" },
        { "value": "75vh", "label": "75vh" },
        { "value": "80vh", "label": "80vh" },
        { "value": "90vh", "label": "90vh" },
        { "value": "100vh", "label": "100vh (Full)" }
      ],
      "default": "65vh"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "When Results Plateau, the Issue Is Rarely Effort."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Font Size",
      "options": [
        { "value": "36px", "label": "36px" },
        { "value": "42px", "label": "42px" },
        { "value": "48px", "label": "48px" },
        { "value": "54px", "label": "54px" },
        { "value": "60px", "label": "60px" },
        { "value": "68px", "label": "68px" }
      ],
      "default": "54px"
    },
    {
      "type": "header",
      "content": "Body Copy"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body / Subtitle Text",
      "default": "Radiant Life™ is a diagnostic-led system designed to identify biological constraints, track response over time, and apply only what limits progress — without guessing."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#EAF3F1"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Begin the Assessment"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL",
      "default": "/pages/assessment"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA Background Color",
      "default": "#3D7A72"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Micro Text"
    },
    {
      "type": "text",
      "id": "micro_text",
      "label": "Micro Text (below button)",
      "default": "No pricing. No product selection. Measurement comes first."
    }
  ],
  "presets": [
    {
      "name": "Home — Hero"
    }
  ]
}
{% endschema %}
